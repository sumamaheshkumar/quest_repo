{
  "datasets": [
    {
      "name": "297c92ff",
      "displayName": "Population Statistics",
      "queryLines": [
        "SELECT\r\n",
        "    run_id,\r\n",
        "    start_year,\r\n",
        "    end_year,\r\n",
        "    distinct_year_count,\r\n",
        "    mean_population,\r\n",
        "    stddev_population\r\n",
        "FROM workspace.rearc.gold_population_statistics;"
      ]
    },
    {
      "name": "bc485894",
      "displayName": "Target Series and Population",
      "queryLines": [
        "SELECT\r\n",
        "    run_id,\r\n",
        "    series_id,\r\n",
        "    year,\r\n",
        "    period,\r\n",
        "    value AS bls_value,\r\n",
        "    population,\r\n",
        "    population_status\r\n",
        "FROM workspace.rearc.gold_target_series_population\r\n",
        "ORDER BY year;"
      ]
    },
    {
      "name": "38b04002",
      "displayName": "Best Year by Series",
      "queryLines": [
        "SELECT\r\n",
        "    series_id,\r\n",
        "    series_label,\r\n",
        "    sector_name,\r\n",
        "    measure_text,\r\n",
        "    duration_text,\r\n",
        "    seasonal_text,\r\n",
        "    best_year,\r\n",
        "    quarterly_value_sum,\r\n",
        "    quarter_count,\r\n",
        "    tied_year_count\r\n",
        "FROM workspace.rearc.gold_best_year\r\n",
        "WHERE result_status = 'AVAILABLE'\r\n",
        "ORDER BY series_id;"
      ]
    },
    {
      "name": "779e9ad7",
      "displayName": "Current Snapshot Validation",
      "queryLines": [
        "WITH current_snapshots AS (\r\n",
        "    SELECT DISTINCT run_id\r\n",
        "    FROM workspace.rearc.silver_snapshot_files\r\n",
        "),\r\n",
        "ranked_validation AS (\r\n",
        "    SELECT\r\n",
        "        *,\r\n",
        "        ROW_NUMBER() OVER (\r\n",
        "            PARTITION BY snapshot_run_id\r\n",
        "            ORDER BY finished_at DESC, validation_id DESC\r\n",
        "        ) AS rn\r\n",
        "    FROM workspace.rearc_ops.validation_runs\r\n",
        "    WHERE source_schema = 'workspace.rearc'\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    s.run_id AS snapshot_run_id,\r\n",
        "    COALESCE(v.status, 'NOT_CHECKED') AS validation_status,\r\n",
        "    v.started_at,\r\n",
        "    v.finished_at AS last_validated_at,\r\n",
        "    v.workflow_run_id,\r\n",
        "    v.validation_id,\r\n",
        "    v.validation_output,\r\n",
        "    v.error_details\r\n",
        "FROM current_snapshots s\r\n",
        "LEFT JOIN ranked_validation v\r\n",
        "    ON s.run_id = v.snapshot_run_id\r\n",
        "   AND v.rn = 1;"
      ]
    },
    {
      "name": "e6a88f52",
      "displayName": "Snapshot Freshness",
      "queryLines": [
        "WITH current_snapshots AS (\r\n",
        "    SELECT DISTINCT run_id\r\n",
        "    FROM workspace.rearc.silver_snapshot_files\r\n",
        "),\r\n",
        "manifests AS (\r\n",
        "    SELECT\r\n",
        "        run_id,\r\n",
        "        MAX(completed_at) AS snapshot_completed_at\r\n",
        "    FROM workspace.rearc.bronze_manifests\r\n",
        "    WHERE status = 'published'\r\n",
        "    GROUP BY run_id\r\n",
        "),\r\n",
        "population_coverage AS (\r\n",
        "    SELECT\r\n",
        "        run_id,\r\n",
        "        MIN(year) AS population_first_year,\r\n",
        "        MAX(year) AS population_latest_year,\r\n",
        "        COUNT(DISTINCT year) AS population_year_count\r\n",
        "    FROM workspace.rearc.silver_population\r\n",
        "    WHERE nation_id = '01000US'\r\n",
        "    GROUP BY run_id\r\n",
        "),\r\n",
        "bls_coverage AS (\r\n",
        "    SELECT\r\n",
        "        run_id,\r\n",
        "        MIN(year) AS target_first_year,\r\n",
        "        MAX(year) AS target_latest_year\r\n",
        "    FROM workspace.rearc.gold_target_series_population\r\n",
        "    GROUP BY run_id\r\n",
        ")\r\n",
        "SELECT\r\n",
        "    s.run_id,\r\n",
        "    m.snapshot_completed_at,\r\n",
        "    p.population_first_year,\r\n",
        "    p.population_latest_year,\r\n",
        "    p.population_year_count,\r\n",
        "    b.target_first_year,\r\n",
        "    b.target_latest_year\r\n",
        "FROM current_snapshots s\r\n",
        "LEFT JOIN manifests m ON s.run_id = m.run_id\r\n",
        "LEFT JOIN population_coverage p ON s.run_id = p.run_id\r\n",
        "LEFT JOIN bls_coverage b ON s.run_id = b.run_id;"
      ]
    },
    {
      "name": "60f3f342",
      "displayName": "Population Match Coverage",
      "queryLines": [
        "SELECT\r\n",
        "    run_id,\r\n",
        "    population_status,\r\n",
        "    COUNT(*) AS observation_count\r\n",
        "FROM workspace.rearc.gold_target_series_population\r\n",
        "GROUP BY run_id, population_status;"
      ]
    }
  ],
